vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    center: true
  }
}
direction: down

user: "Analyst" {shape: person}

app: "Annual Report Extractor" {
  client: "React client"
  api: "Flask API"
  pipeline: "Pipeline"
  quality: "Contract + quality"
  corpus: "Corpus builder"
  traffic: "Private visit reporter"
  storage: "Uploads / runs / manifest"
  jobs: "Durable extraction jobs"
  cohort: "Matched parser cohort"
  gate: "Strategy 3 intelligent scanning gate"
  gold: "Source-bound audited gold"

  client -> api: "HTTP / SSE"
  client -> api: "select corpus SHA-256"
  client -> api: "review prefilled answers"
  client -> api: "confirm corpus delete"
  api -> pipeline: "execute"
  api -> jobs: "snapshot / rehydrate"
  api -> storage: "validate + stage durable PDF"
  api -> storage: "delete manifest-owned PDF"
  api -> corpus: "background job"
  api -> pipeline: "on-demand review prefill"
  api -> traffic: "bounded metadata"
  pipeline -> quality: "validate / score"
  pipeline -> gold: "exact SHA + company + year"
  gold -> quality: "scorable audited fields"
  pipeline -> gate: "score unified complete pages"
  gate -> pipeline: "top 3-5 source pages"
  pipeline -> storage: "persist"
  pipeline -> jobs: "phase events"
  storage -> cohort: "latest parser/report result"
  cohort -> client: "equal-weight comparison"
  corpus -> storage: "screened-ok PDF + SHA-256 manifest"
}

parsers: "PDF parsers" {shape: cloud}
localocr: "RapidOCR PP-OCRv6 · local ONNX" {shape: cylinder}
llm: "LLM provider" {shape: cloud}
firecrawl: "Firecrawl discovery" {shape: cloud}
official: "Official company sites" {shape: cloud}
upstash: "Upstash Redis" {shape: cloud}
ses: "AWS SES" {shape: cloud}

user -> app.client: "configure / inspect"
app.pipeline -> parsers: "extract"
parsers -> localocr: "OCR-routed pages only · 200 DPI"
app.pipeline -> llm: "chat completion"
app.corpus -> firecrawl: "map / search"
app.api -> firecrawl: "credential probe"
app.corpus -> official: "direct PDF download"
app.traffic -> upstash: "bounded log + counters"
app.traffic -> ses: "owner-only email"

deployment: "Production deployment" {
  vercel: "Vercel · React static UI"
  caddy: "EC2 · Caddy HTTPS"
  gunicorn: "Gunicorn · Flask API"
  disk: "Encrypted gp3 · corpus/uploads/runs"
  parameter: "SSM Parameter Store · backend secrets"

  vercel -> caddy: "cross-origin HTTP / SSE"
  caddy -> gunicorn: "127.0.0.1:8000"
  gunicorn -> disk: "persistent artifacts"
  parameter -> gunicorn: "private connectors"
}
