[Unit]
Description=Ledger annual-report extraction API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/opt/ledger
EnvironmentFile=/etc/ledger/backend.env
ExecStart=/opt/ledger/.venv/bin/gunicorn --worker-class gthread --workers 1 --threads 4 --timeout 1800 --bind 127.0.0.1:8000 server:app
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
