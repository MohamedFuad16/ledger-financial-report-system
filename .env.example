# Provider: openrouter | zai | zai-coding | openai | custom
LLM_PROVIDER=openrouter
LLM_API_KEY=
# OpenRouter default. Any model id the provider exposes works.
LLM_MODEL=deepseek/deepseek-v4-flash-latest
LLM_BASE_URL=https://openrouter.ai/api/v1
# none | minimal | low | medium | high | xhigh | max   ("none" disables reasoning)
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.1
LLM_MAX_CONCURRENCY=6
LLM_AUTO_CONCURRENCY=true

# Firecrawl — only needed for the planned large-scale corpus builder (ROADMAP.md)
FIRECRAWL_API_KEY=

# Hosted backend only. Mutating API calls require this token when configured.
LEDGER_ADMIN_TOKEN=
# Comma-separated origins, or * when bearer-token protection is enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Private, backend-only traffic reporting. Never prefix these with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRAFFIC_NOTIFY_EMAIL=
TRAFFIC_FROM_EMAIL=
